<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.showslides.carousel" ExtensionBundleVersion="2.0.0"
    ExtensionBundleName="ShowSlides 3D Carousel" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.showslides.carousel.panel" Version="2.0.0" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <!-- After Effects CC 2020 (17.0) to AE 2025+ (99.9) -->
            <Host Name="AEFT" Version="[17.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="9.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.showslides.carousel.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/index.html</MainPath>
                    <ScriptPath>./host/index.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>ShowSlides 3D Carousel</Menu>
                    <Geometry>
                        <Size>
                            <Height>690</Height>
                            <Width>340</Width>
                        </Size>
                        <MinSize>
                            <Height>450</Height>
                            <Width>280</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>1400</Height>
                            <Width>600</Width>
                        </MaxSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
